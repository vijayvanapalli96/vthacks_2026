# Copy to .env.local (gitignored) and fill in. Nothing real belongs in this file.

# --- Databricks (primary extraction path + profile memory) -------------------
# Team workspace host, no trailing slash. Profile TEAM, NOT the personal throwaway.
DATABRICKS_HOST=https://<team-workspace-host>
# Personal access token, or an OAuth token. Never commit a real one.
DATABRICKS_TOKEN=
# Serverless Starter warehouse on the team workspace.
DATABRICKS_WAREHOUSE_ID=441b670a0ff475e0

# --- Extraction provider ----------------------------------------------------
# databricks | gemini | auto. auto = Gemini when a key is present (better on
# two-column resumes), otherwise Databricks ai_query (no key, no rate limit).
EXTRACT_PROVIDER=auto

# --- Gemini (multimodal PDF path, optional) ---------------------------------
# From Google AI Studio. Absent is fine: the Databricks path is the floor.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Local dev -------------------------------------------------------------
# Where the dev profile-memory store lives when Databricks is unconfigured.
PROFILE_STORE=.data/profile-memory.json
# Stand-in user id until feat/auth-template lands real sessions.
DEV_USER_ID=dev-applicant
