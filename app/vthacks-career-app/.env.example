# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Signs the session JWT. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Web application", then add this exact
# authorized redirect URI (and the deployed equivalent):
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin of the app. Required in production because Databricks Apps
# terminates TLS in front of us; locally you can leave it unset.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Databricks — REQUIRED. Accounts live in workspace.vthacks_2026.users, so
# without these you cannot sign up or sign in at all; src/lib/databricks.ts
# throws rather than falling back. There is no local user store any more.
# ---------------------------------------------------------------------------
DATABRICKS_HOST=https://dbc-0bfd7b56-c2eb.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=441b670a0ff475e0

# Auth is resolved in this order:
#   1. DATABRICKS_TOKEN            — a PAT. NOT usable here: this workspace has
#                                    tokens disabled ("User does not have
#                                    permission to use tokens").
#   2. DATABRICKS_CLIENT_ID/_SECRET — OAuth M2M. Databricks Apps injects these
#                                    in production, so leave them unset locally.
#   3. the CLI's own OAuth token    — what local dev actually uses. Requires
#                                    `databricks auth login --host <host> --profile TEAM`
#                                    to have been run once.
DATABRICKS_CONFIG_PROFILE=TEAM

# Only needed if `databricks` is not on PATH (common on Windows after winget).
# DATABRICKS_CLI_PATH=C:/Users/<you>/AppData/Local/Microsoft/WinGet/Links/databricks.exe

# First sign-in after an idle period blocks 20-30s while the serverless warehouse
# cold-starts. Fire any query a couple of minutes before demoing.
