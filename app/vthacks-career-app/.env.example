# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Signs the session JWT. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Web application", then add this exact
# authorized redirect URI (and the deployed equivalent):
#   http://localhost:3000/api/auth/callback/google
# Optional: with these blank the Google button is hidden and email/password still
# works. The app must never render a sign-in method it cannot honour.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin of the app. Required in production because Databricks Apps
# terminates TLS in front of us; locally you can leave it unset.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Databricks — REQUIRED. Accounts live in workspace.vthacks_2026.users and the
# profile lives in the same schema, so without these you cannot sign in at all;
# src/lib/databricks.ts throws rather than falling back.
# ---------------------------------------------------------------------------
DATABRICKS_HOST=https://dbc-0bfd7b56-c2eb.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=441b670a0ff475e0

# Auth is resolved in this order:
#   1. DATABRICKS_TOKEN            — a PAT. NOT usable on this workspace: tokens
#                                    are disabled ("User does not have permission
#                                    to use tokens").
#   2. DATABRICKS_CLIENT_ID/_SECRET — OAuth M2M. Databricks Apps injects these in
#                                    production, so leave them unset locally.
#   3. the CLI's own OAuth token    — what local dev actually uses. Requires
#                                    `databricks auth login --host <host> --profile TEAM`
#                                    to have been run once.
DATABRICKS_TOKEN=
DATABRICKS_CONFIG_PROFILE=TEAM

# Only needed if `databricks` is not on PATH (common on Windows after winget).
# DATABRICKS_CLI_PATH=C:/Users/<you>/AppData/Local/Microsoft/WinGet/Links/databricks.exe

# First sign-in or profile load after an idle period blocks 20-30s while the
# serverless warehouse cold-starts. Fire any query a couple of minutes before
# demoing so it is warm on stage.

# ---------------------------------------------------------------------------
# Resume / document extraction
# ---------------------------------------------------------------------------
# databricks | gemini | auto. auto = Gemini when a key is present (better on
# two-column resumes), otherwise Databricks ai_query (no key, no rate limit).
EXTRACT_PROVIDER=auto

# Gemini, optional. From Google AI Studio. Absent is fine — nothing hard-fails
# without it. It powers TWO things:
#   1. the multimodal resume PDF path (better on two-column layouts). The
#      Databricks ai_query path is the floor and needs no external key.
#   2. search-grounded LinkedIn enrichment (src/lib/enrich/linkedin-web.ts).
#      When only a profile URL was given, this asks a search-grounded model what
#      the PUBLIC web says about the person the resume already identified. It does
#      NOT touch linkedin.com: there is no public profile API and anonymous
#      requests get a login wall. Facts from it are stored with source
#      'web:gemini:<model>' at half confidence under web.* keys and can never
#      override a resume value. With the key absent the intake log says so and
#      points the user at the data-export upload instead.
GOOGLE_GENERATIVE_AI_API_KEY=
