# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Signs the session JWT. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Web application", then add this exact
# authorized redirect URI (and the deployed equivalent):
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin of the app. Required in production because Databricks Apps
# terminates TLS in front of us; locally you can leave it unset.
AUTH_URL=http://localhost:3000

# FILENAME (not a path) for the dev user store, always written inside .data/.
# Defaults to users.json — so the file lands at .data/users.json.
# It is a bare filename because a dynamic directory makes Next trace the whole
# project into the server bundle; see the comment in src/lib/users.ts.
# The Databricks Apps filesystem is EPHEMERAL — this gets swapped for
# workspace.vthacks_2026.users before the real demo.
AUTH_USER_STORE=users.json
