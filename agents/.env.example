PORT=8787
EMPLOYER_ANS_NAME=ans://v1.0.0.employer.example.com
EMPLOYER_ENDPOINT_URL=https://employer.example.com/a2a/apply
APPLICANT_ANS_NAME=ans://v1.0.0.applicant.example.com
AUDIT_LOG_PATH=./audit/events.jsonl
# Add only after real infrastructure exists:
ANS_API_KEY=
VULTR_API_KEY=
MONGODB_URI=
MONGODB_DATABASE=vthacks

# --- ATS worker (Playwright lane) ---------------------------------------
# Shared secret the applicant agent presents as X-Ats-Token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The worker rejects every request while this is unset.
ATS_WORKER_TOKEN=
ATS_WORKER_PORT=8789
# Kill switch. "true" lets the worker click Submit on a real employer's form.
# Anything else prepares the form and stops. Deploy false; flip it deliberately.
ATS_ALLOW_SUBMIT=false
ATS_ARTIFACT_DIR=./work/ats
